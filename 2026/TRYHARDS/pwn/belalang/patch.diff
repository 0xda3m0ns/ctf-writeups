diff --git a/lib/AST/Parser.cpp b/lib/AST/Parser.cpp
index f56a3d8..bd8b0bf 100644
--- a/lib/AST/Parser.cpp
+++ b/lib/AST/Parser.cpp
@@ -525,12 +525,15 @@ Expr *Parser::parseCallExpr(Expr *left) {
   size_t start = left->getSpanStart();
   consumeToken(); // consume `(`
 
+  llvm::SmallVector<int64_t, 0> integerArgs;
